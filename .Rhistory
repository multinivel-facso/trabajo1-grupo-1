#| echo: false
pacman::p_load(lme4, reghelper, haven, stargazer, ggplot2, texreg, dplyr,
foreign, lattice, sjPlot, sjlabelled, skimr, influence.ME,
patchwork, kableExtra)
library(ggeffects)
#| label: Base sin NA
#| echo: false
icils <- icils_final %>%
na.omit()
#| label: Agregar labels a las variables
#| echo: false
icils$sexo <- set_label(icils$sexo, "Sexo de estudiante")
icils$expcompu <- set_label(icils$expcompu, "Experiencia con computador en años")
icils$aprendizaje_escuela <- set_label(icils$aprendizaje_escuela, "Tareas relacionadas al aprendizaje online en la escuela")
icils$autoeffgen <- set_label(icils$autoeffgen, "Autoeficacia digital general del estudiante")
icils$iiseb <- set_label(icils$iiseb, "Índice Socioeconómico Internacional")
icils$alf_digital <- set_label(icils$alf_digital, "Puntaje de alfabetización digital")
icils$adm_digital <- set_label(icils$adm_digital, "Administración digital")
icils$pib <- set_label(icils$pib, "Producto Interno Bruto per cápita")
#| label: Base agregada
#| echo: false
icils_lvl_2 <- icils %>% group_by(CNTRY) %>% summarise_all(funs(mean))
#| tbl-cap: "Variables nivel 1"
#| tbl-cap-location: bottom
#| label: tbl-descr1
#| echo: false
icils %>%  select (alf_digital, sexo, expcompu, aprendizaje_escuela,
autoeffgen, iiseb) %>%
haven::zap_labels() %>%
sjmisc::descr(.,
show = c("label","range", "mean", "sd", "NA.prc", "n"))%>%
kable(., digits =2, "markdown")
#| label: Distancia de Cook
#| include: false
cases <- influence(results_3, "CNTRY")
#| include: false
results_3 = lmer(alf_digital ~ 1 + pib + adm_digital + (1 | CNTRY), data = icils_c)
#| label: Centrado de variables
#| echo: false
icils_c <- icils %>%
group_by(CNTRY) %>%
mutate(sexo.cmc = sexo-mean(sexo),
expcompu.cmc = expcompu-mean(expcompu),
aprendizaje_escuela.cmc = aprendizaje_escuela-mean(aprendizaje_escuela),
autoeffgen.cmc = autoeffgen-mean(autoeffgen),
iiseb.cmc = iiseb-mean(iiseb)) %>%
ungroup()
#| include: false
results_3 = lmer(alf_digital ~ 1 + pib + adm_digital + (1 | CNTRY), data = icils_c)
screenreg(results_3)
#| caption: Modelo nulo
#| include: false
results = lmer(alf_digital ~ 1 + (1 | CNTRY), data = icils_c)
reghelper::ICC(results)
#| caption: Modelo variables nivel 1
#| include: false
results_1 = lmer(alf_digital ~ 1 + sexo.cmc + iiseb.cmc + expcompu.cmc + autoeffgen.cmc + aprendizaje_escuela.cmc + (1 | CNTRY), data = icils_c)
screenreg(results_1, naive=TRUE)
#| caption: Modelo variables nivel 2
#| include: false
results_2 = lmer(alf_digital ~ 1 + pib + (1 | CNTRY), data = icils_c)
screenreg(results_2)
#| include: false
results_3 = lmer(alf_digital ~ 1 + pib + adm_digital + (1 | CNTRY), data = icils_c)
screenreg(results_3)
#| include: false
results_4 = lmer(alf_digital ~ 1 + sexo.cmc + iiseb.cmc + expcompu.cmc +
autoeffgen.cmc + aprendizaje_escuela.cmc + pib +
adm_digital + (1 | CNTRY), data = icils_c)
screenreg(results_4)
#| label: Comparación modelos
#| echo: false
tab_model(results, results_1, results_2, results_3, results_4,
show.ci = FALSE,
show.se = TRUE,
collapse.se = TRUE,
show.p = FALSE,
p.style = c("scientific_stars"),
dv.labels = c("Modelo nulo", "Variables nivel 1", "PIB per cápita",
"Variables nivel 2", "Modelo completo")
)
#| label: Pendiente aleatorizada de Índice Socioeconómico
#| include: false
reg_1 <- lmer(alf_digital ~ 1 + iiseb.cmc + adm_digital + (1 | CNTRY), data = icils_c)
reg_random <- lmer(alf_digital ~ 1 + iiseb.cmc + adm_digital + (1 + iiseb | CNTRY), data = icils_c)
screenreg(list(reg_1, reg_random))
#| label: Gráfico pendiente aleatoria
graf2 <- ggpredict(reg_random, terms = c("iiseb", "CNTRY [sample=9]"), type = "random")
graf2
plot(graf2)
#| tbl-cap: "Variables nivel 1"
#| tbl-cap-location: bottom
#| label: tbl-descr1
#| echo: false
icils %>%  select (alf_digital, sexo, expcompu, aprendizaje_escuela,
autoeffgen, iiseb) %>%
haven::zap_labels() %>%
sjmisc::descr(.,
show = c("label","range", "mean", "sd", "NA.prc", "n"))%>%
kable(., digits =2, "markdown")
library(knitr)
knitr::opts_chunk$set(echo = TRUE, include = TRUE, warning = FALSE, message = FALSE, cache = TRUE)
table_format <- if(is_html_output()) {
"html"
} else if(is_latex_output()) {
"latex"
}
table_format2 <- if(is_html_output()) {
T
} else if(is_latex_output()) {
F
}
options(kableExtra.html.bsTable = T)
options(knitr.kable.NA = "")
scatter2 <- icils %>% group_by(CNTRY) %>% select(alf_digital, pib) %>%
na.omit() %>%
summarise_all(mean)
View(scatter2)
scatter2$pib2 <- scatter2$pib^2
sjPlot::plot_scatter(scatter2, pib2, alf_digital,
dot.labels = to_label(scatter$CNTRY),
fit.line = "lm",
show.ci = TRUE,
axis.titles = c("Producto Interno Bruto per cápita ($US)",
"Alfabetización digital"),
colors = "#7b241c"
)
sjPlot::plot_scatter(scatter2, pib2, alf_digital,
dot.labels = to_label(scatter2$CNTRY),
fit.line = "lm",
show.ci = TRUE,
axis.titles = c("Producto Interno Bruto per cápita ($US)",
"Alfabetización digital"),
colors = "#7b241c"
)
scatter2$logpib <- log(scatter2$pib)
sjPlot::plot_scatter(scatter2, logpib, alf_digital,
dot.labels = to_label(scatter2$CNTRY),
fit.line = "lm",
show.ci = TRUE,
axis.titles = c("Producto Interno Bruto per cápita ($US)",
"Alfabetización digital"),
colors = "#7b241c"
)
cor(scatter2$alf_digital, scatter2$logpib)
cor(scatter2$alf_digital, scatter2$pib)
cor(scatter2$alf_digital, scatter2$logpib)
#| label: Centrado de variables
#| echo: false
icils_c <- icils %>%
group_by(CNTRY) %>%
mutate(sexo.cmc = sexo-mean(sexo),
expcompu.cmc = expcompu-mean(expcompu),
aprendizaje_escuela.cmc = aprendizaje_escuela-mean(aprendizaje_escuela),
autoeffgen.cmc = autoeffgen-mean(autoeffgen),
iiseb.cmc = iiseb-mean(iiseb)) %>%
ungroup()
#| caption: Modelo nulo
#| include: false
results = lmer(alf_digital ~ 1 + (1 | CNTRY), data = icils_c)
reghelper::ICC(results)
icils_c$logpib <- log(icils_c$pib)
View(icils_c)
results_log = lmer(alf_digital ~ 1 + logpib + adm_digital + (1 | CNTRY), data = icils_c)
screenreg(results_3)
results_log = lmer(alf_digital ~ 1 + logpib + adm_digital + (1 | CNTRY), data = icils_c)
screenreg(results_3)
results_log = lmer(alf_digital ~ 1 + logpib + adm_digital + (1 | CNTRY), data = icils_c)
screenreg(results_log)
sjPlot::plot_scatter(scatter, adm_digital, alf_digital,
dot.labels = to_label(scatter$CNTRY),
fit.line = "lm",
show.ci = TRUE,
axis.titles = c("adm_digital",
