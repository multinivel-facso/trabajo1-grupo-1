fit.line = "lm",
show.ci = TRUE,
axis.titles = c("logdigital",
"Alfabetización digital"),
colors = "#7b241c"
)
cor(scatter$alf_digital, scatter$adm_digital)
cor(scatter$alf_digital, scatter$logdigital)
cor(scatter$alf_digital, scatter$adm_digital)
cor(scatter$alf_digital, scatter$logdigital)
